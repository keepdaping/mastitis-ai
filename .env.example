# Copy to .env and fill in. .env is git-ignored: never commit real keys.

# SMS provider: "console" (default; prints messages, sends nothing) or "africastalking"
SMS_PROVIDER=console

# Africa's Talking (only used when SMS_PROVIDER=africastalking)
# Sandbox: username "sandbox", API key from https://account.africastalking.com/apps/sandbox
AT_USERNAME=sandbox
AT_API_KEY=
# Optional sender ID / short code (leave empty in the sandbox)
AT_SENDER_ID=

# SMS language: "en" (English) or "lg" (Luganda - placeholder, falls back to English for now)
SMS_LANGUAGE=en

# SQLite database file (default data/app.db)
# MASTITIS_DB=data/app.db
